{
  "name": "@aiappfactory/keycloak-admin",
  "version": "0.1.0",
  "description": "Realm/client/role/user provisioning against Keycloak's Admin REST API (ADR-006). Used by scripts/dev-server.ts and by test suites that need a real, fully-configured realm — not a general-purpose Keycloak client library.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/integration/**'",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage --exclude '**/integration/**'"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
