{
  "name": "@aiappfactory/auth-bff",
  "version": "0.1.0",
  "description": "OIDC Authorization Code + PKCE, BFF pattern (ADR-006) — the browser never holds a token, only an httpOnly session cookie. Reusable across apps/runtime and (eventually) apps/console, since both need the exact same pattern with a different OIDC client per app.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/integration/**'",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage --exclude '**/integration/**'"
  },
  "dependencies": {
    "openid-client": "^6.8.0"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@aiappfactory/keycloak-admin": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "fastify": "^5.12.3",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  }
}
